{
  "name": "@tuquet/skills",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@12.16.1",
  "description": "Tuquet curated agent skills, one `npm i` away",
  "author": "Tuquet Team <dev@tuquet.com>",
  "license": "MIT",
  "homepage": "https://github.com/tuquet/skills-pack#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuquet/skills-pack.git"
  },
  "bugs": "https://github.com/tuquet/skills-pack/issues",
  "keywords": [
    "agent",
    "skills",
    "skills-npm",
    "ai",
    "claude",
    "opencode",
    "cursor"
  ],
  "files": [
    "skills"
  ],
  "scripts": {
    "gen": "tsx scripts/fetch-skills.ts && tsx scripts/gen.ts",
    "lint": "pnpm run gen --check && eslint",
    "test": "tsx scripts/test.ts",
    "typecheck": "tsc",
    "prepare": "git config core.hooksPath .githooks && simple-git-hooks",
    "sync:skills": "tsx scripts/fetch-skills.ts"
  },
  "scripts-info": {
    "gen": "Sync package.json `skills` field and README table from meta.ts",
    "lint": "Check generated files are in sync and code style",
    "test": "Install the pack into a temp project and verify every skill lands",
    "typecheck": "Check types",
    "prepare": "Set up git hooks",
    "sync:skills": "Fetch and bundle all upstream SKILL.md files into skills/ directory"
  },
  "skills": [
    {
      "source": "mattpocock/skills",
      "skills": [
        "grill-me",
        "grilling",
        "handoff",
        "to-questionnaire",
        "writing-for-agents",
        "teach",
        "code-review",
        "codebase-design",
        "research",
        "tdd"
      ]
    },
    "shadcn/improve",
    "kucherenko/jscpd/skills/dry-refactoring",
    "AminBlg/SimpleEnglish",
    "cursor/plugins/pstack/skills/unslop",
    "ayghri/i-have-adhd",
    {
      "source": "antfu/skills",
      "skills": [
        "antfu",
        "antfu-create-pr",
        "antfu-issue-triage",
        "antfu-simplify",
        "antfu-query"
      ]
    },
    {
      "source": "vuejs-ai/skills",
      "skills": [
        "vue-best-practices",
        "vue-router-best-practices",
        "vue-pinia-best-practices",
        "vue-testing-best-practices",
        "vue-debug-guides",
        "create-adaptable-composable"
      ]
    },
    {
      "source": "onmax/nuxt-skills",
      "skills": [
        "nuxt-modules"
      ]
    },
    "anthropics/skills/skills/frontend-design",
    "vercel-labs/agent-browser",
    "full-stack-skills/tauri-skills/skills"
  ],
  "devDependencies": {
    "@antfu/eslint-config": "catalog:cli",
    "@types/node": "catalog:types",
    "bumpp": "catalog:cli",
    "eslint": "catalog:cli",
    "eslint-plugin-slop": "catalog:cli",
    "eslint-plugin-sonarjs": "catalog:cli",
    "nano-staged": "catalog:cli",
    "simple-git-hooks": "catalog:cli",
    "skills": "catalog:cli",
    "tsx": "catalog:cli",
    "typescript": "catalog:cli",
    "yaml": "catalog:cli"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm i --frozen-lockfile --ignore-scripts --offline && npx nano-staged"
  },
  "nano-staged": {
    "*.{ts,js,mjs}": "eslint --fix"
  }
}
